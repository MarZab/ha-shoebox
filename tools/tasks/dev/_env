# Sourced by the dev tasks: the Home Assistant version the tests run on, and sample media.
HA_VERSION=$(uv run --quiet python -c "from homeassistant.const import __version__; print(__version__)")
export HA_VERSION
[ -d tools/docker/media ] || uv run --quiet python tools/scripts/sample_media.py tools/docker/media
# A first configuration: My media, and a country so Settings shows no "country not configured"
# repair (it would badge every screenshot). Home Assistant keeps it after that.
if [ ! -f tools/docker/ha-config/configuration.yaml ]; then
  mkdir -p tools/docker/ha-config
  cat > tools/docker/ha-config/configuration.yaml <<'YAML'
default_config:

homeassistant:
  country: US
  media_dirs:
    local: /media
YAML
fi
compose() { docker compose -f tools/docker/compose.yaml "$@"; }
