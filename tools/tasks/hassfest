#!/usr/bin/env bash
#MISE description="Validate the integration with hassfest of the latest Home Assistant, as CI does"
set -euo pipefail
repo=$PWD
# The latest stable Home Assistant, as CI runs hassfest on a current one: the manifest may use
# keys (such as categories) newer than the version the tests are pinned to. HASSFEST_VERSION
# picks another release.
version=${HASSFEST_VERSION:-$(git ls-remote --tags --refs https://github.com/home-assistant/core.git 'refs/tags/20*' \
  | sed 's#.*refs/tags/##' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)}
core="$repo/.cache/hassfest/core-$version"
venv="$repo/.cache/hassfest/venv-$version"
if [ ! -d "$core" ]; then
  git clone --quiet --depth 1 --branch "$version" https://github.com/home-assistant/core.git "$core"
fi
if [ ! -d "$venv" ]; then
  # hassfest runs on that release of Home Assistant, plus what only hassfest needs
  uv venv --quiet --python 3.14 "$venv"
  VIRTUAL_ENV="$venv" uv pip install --quiet "homeassistant==$version" infrared_protocols pipdeptree tqdm
  # since 2026.11 hassfest is a package of its own, inside core
  if [ -d "$core/packages/hassfest" ]; then
    VIRTUAL_ENV="$venv" uv pip install --quiet "$core/packages/hassfest"
  fi
fi
cd "$core"
PATH="$venv/bin:$repo/.venv/bin:$PATH" "$venv/bin/python" -m script.hassfest \
  --action validate --integration-path "$repo/custom_components/shoebox"
